{
  "name": "capstone",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js && cpy \"src/generated/prisma/**/*\" dist/generated/prisma --parents && node -e \"const fs=require('fs'); const p='dist/lib/prisma.js'; let s=fs.readFileSync(p,'utf8'); s=s.replace('@/generated/prisma/client','../generated/prisma/client.js'); fs.writeFileSync(p,s);\"",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.15",
    "openai": "^4.68.0",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "cpy-cli": "^7.0.0",
    "prisma": "^7.9.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsc-esm-fix": "^3.1.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
