generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(uuid())
  fullName         String
  email            String           @unique
  password         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  focusSessions    FocusSession[]
  notifications    Notification[]
  recentActivities RecentActivity[]
  subjects         subjects[]
  tasks            Task[]
  transactions     Transaction[]
  notes            Note[]
  noteTemplates    NoteTemplate[]

  @@map("users")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  subject     String
  priority    String
  dueDate     String
  dueTime     String
  hasReminder Boolean   @default(false)
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  subTasks    SubTask[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tasks")
}

model SubTask {
  id        String  @id @default(uuid())
  title     String
  completed Boolean @default(false)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("sub_tasks")
}

model Notification {
  id           String   @id @default(uuid())
  title        String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  userId       String
  assignmentId String?
  icon         String
  iconColor    String
  taskId       String?
  time         String
  type         String
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([assignmentId])
  @@map("notifications")
}

model FocusSession {
  id            String   @id @default(uuid())
  userId        String
  duration      Int
  remainingTime Int
  targetHours   Float    @default(1.5)
  status        String   @default("IDLE")
  ambientSound  String   @default("NONE")
  isStrict      Boolean  @default(false)
  subject       String?
  focusMode     String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("focus_sessions")
}

model RecentActivity {
  id        String   @id @default(uuid())
  userId    String
  icon      String
  text      String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("recent_activities")
}

model subjects {
  id        String   @id
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id        String   @id @default(uuid())
  title     String
  amount    Float
  type      String
  category  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@map("transactions")
}

model Note {
  id         String   @id @default(uuid())
  title      String   @default("Untitled Note")
  content    String   @default("")
  type       String   @default("BLANK")
  category   String   @default("General")
  tags       String[] @default([])
  isPinned   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isPinned])
  @@index([isFavorite])
  @@index([isArchived])
  @@map("notes")
}

model NoteTemplate {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  content     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String? // null = built-in template shared by everyone
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("note_templates")
}
