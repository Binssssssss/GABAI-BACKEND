generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  fullName          String
  email             String              @unique
  password          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  focus_sessions    focus_sessions[]
  notifications     notifications[]
  recent_activities recent_activities[]
  tasks             Task[]
  subjects          Subject[]
  transactions      Transaction[]

  @@map("users")
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("subjects")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  subject     String
  priority    String
  dueDate     String
  dueTime     String
  hasReminder Boolean   @default(false)
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  subTasks    SubTask[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tasks")
}

model SubTask {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("sub_tasks")
}

model focus_sessions {
  id            String    @id
  userId        String
  duration      Int
  remainingTime Int
  targetHours   Float     @default(1.5)
  status        String    @default("IDLE")
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  users         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model notifications {
  id           String   @id
  title        String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  userId       String
  assignmentId String?
  icon         String
  iconColor    String
  taskId       String?
  time         String
  type         String
  updatedAt    DateTime
  users        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([taskId])
  @@index([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  type      String
  category  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("transactions")
}

model recent_activities {
  id        String   @id
  userId    String
  icon      String
  text      String
  type      String
  createdAt DateTime @default(now())
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}
